# Environment Variables
# Copy this file to .env and fill in your values.

# Database
# For local development with SQLite:
DATABASE_URL=sqlite:./data/academic-compass.sqlite
# For production with Supabase PostgreSQL:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
#
# A fresh Postgres database starts EMPTY. Before pointing the server at one,
# copy the existing SQLite data across (profiles, roles, marks, conflicts,
# school data, SMS logs):
#   cd artifacts/api-server
#   DATABASE_URL=postgresql://... pnpm run migrate:postgres
# Add --dry-run first to preview row counts. The script refuses to overwrite a
# database that already has profiles unless you pass --force.

# Session / JWT
SESSION_SECRET=your-secret-key-here

# Server
PORT=8080

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:21550,http://localhost:5173

# Supabase Auth (required for production)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Frontend
VITE_PORT=21550
VITE_API_ORIGIN=http://localhost:8080
VITE_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
